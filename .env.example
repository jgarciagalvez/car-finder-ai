# Environment Configuration
# Copy this file to .env and fill in your own values

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-pro
AI_RATE_LIMIT_RPM=60
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Database Configuration
DATABASE_PATH=./data/vehicles.db
TEST_DATABASE_PATH=./data/vehicles.test.db

# Application Configuration
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
API_BASE_URL=http://localhost:3000

# Google Maps Configuration (Optional)
# Required for displaying interactive maps on vehicle detail pages
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
# Enable "Maps Embed API" for your project
# IMPORTANT: Use NEXT_PUBLIC_ prefix to expose to client-side Next.js app
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
